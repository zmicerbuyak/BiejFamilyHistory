\\u043A\\u0430\\u045E \\u0437 \\u0443\\u043A\\u0430\\u0437\\u0430\\u043D\\u044C\\u043D\\u0435\\u043C \\u0434\\u044B\\u043C\\u043E\\u045E (dym\\xF3w) \\u0456 \\u0442\\u044B\\u0445, \\u0445\\u0442\\u043E \\u045E \\u0456\\u0445 \\u0436\\u044B\\u0432\\u0435, \\u0434\\u0443\\u0448 \\u043C\\u0443\\u0436\\u0447\\u044B\\u043D\\u0441\\u043A\\u0430\\u0433\\u0430 \\u0456 \\u0436\\u0430\\u043D\\u043E\\u0447\\u0430\\u0433\\u0430 \\u043F\\u043E\\u043B\\u0443. \\u0421\\u043B\\u043E\\u0432\\u0430 \\xAB\\u0434\\u044B\\u043C\\xBB \\u0443 \\u0434\\u0430\\u0434\\u0437\\u0435\\u043D\\u044B\\u043C \\u043A\\u0430\\u043D\\u0442\\u044D\\u043A\\u0441\\u044C\\u0446\\u0435 \\u0430\\u0437\\u043D\\u0430\\u0447\\u0430\\u043B\\u0430 \\u0430\\u0441\\u043E\\u0431\\u043D\\u0443\\u044E \\u0441\\u044F\\u043B\\u044F\\u043D\\u0441\\u043A\\u0443\\u044E \\u0433\\u0430\\u0441\\u043F\\u0430\\u0434\\u0430\\u0440\\u043A\\u0430\\u0443, \\u0442\\u043E \\u0431\\u043E\\u043A \\u0434\\u043E\\u043C, \\u0447\\u0430\\u0441\\u0446\\u0435\\u0439 \\u0437\\u0430 \\u045E\\u0441\\u0451 \\u043F\\u0430\\u0434 \\u043A\\u0456\\u0440\\u0430\\u045E\\u043D\\u0456\\u0446\\u0442\\u0432\\u0430\\u043C \\u0430\\u0434\\u043D\\u0430\\u0433\\u043E \\u0433\\u0430\\u043B\\u0430\\u0432\\u044B \\u0441\\u044F\\u043C\\u2019\\u0456. \\u0423 \\u043F\\u0435\\u0440\\u0430\\u043F\\u0456\\u0441\\u0430\\u0445 \\u0456 \\u043F\\u0430\\u0434\\u0430\\u0442\\u043A\\u043E\\u0432\\u044B\\u0445 \\u0441\\u044C\\u043F\\u0456\\u0441\\u0430\\u0445 \\xAB\\u0434\\u044B\\u043C\\u044B\\xBB \\u0441\\u043B\\u0443\\u0436\\u044B\\u043B\\u0456 \\u0430\\u0434\\u0437\\u0456\\u043D\\u043A\\u0430\\u0439 \\u0443\\u043B\\u0456\\u043A\\u0443 \\u0434\\u043B\\u044F \\u043F\\u0430\\u0434\\u0430\\u0442\\u043A\\u0430\\u0430\\u0431\\u043A\\u043B\\u0430\\u0434\\u0430\\u043D\\u044C\\u043D\\u044F. \\u0410\\u0434\\u0437\\u0456\\u043D \\xAB\\u0434\\u044B\\u043C\\xBB \\u043C\\u043E\\u0433 \\u0443\\u043A\\u043B\\u044E\\u0447\\u0430\\u0446\\u044C \\u043D\\u0435\\u043A\\u0430\\u043B\\u044C\\u043A\\u0456 \\u043F\\u0430\\u043A\\u0430\\u043B\\u0435\\u043D\\u044C\\u043D\\u044F\\u045E \\u0430\\u0434\\u043D\\u043E\\u0439 \\u0441\\u044F\\u043C\\u2019\\u0456. \\u0427\\u0430\\u0441\\u0430\\u043C \\u043D\\u0435\\u043A\\u0430\\u043B\\u044C\\u043A\\u0456 \\xAB\\u0434\\u0443\\u0448\\xBB \\u0443 \\u0430\\u0434\\u043D\\u044B\\u043C \\xAB\\u0434\\u044B\\u043C\\u0435\\xBB \\u043C\\u0435\\u043B\\u0456 \\u0440\\u043E\\u0437\\u043D\\u044B\\u044F \\u043F\\u0440\\u043E\\u0437\\u0432\\u0456\\u0448\\u0447\\u044B \\u2014 \\u044F\\u043D\\u044B \\u043C\\u0430\\u0433\\u043B\\u0456 \\u0431\\u044B\\u0446\\u044C \\u0441\\u0432\\u0430\\u044F\\u043A\\u0430\\u043C\\u0456 \\u0430\\u0431\\u043E \\u0436\\u044B\\u0445\\u0430\\u0440\\u0430\\u043C\\u0456 \\u0430\\u0434\\u043D\\u0430\\u0433\\u043E \\u0433\\u0430\\u0441\\u043F\\u0430\\u0434\\u0430\\u0440\\u0441\\u0442\\u0432\\u0430.\"}),/*#__PURE__*/_jsx(Typography,{className:styles.textBlock,children:\"\\u0426\\u044F\\u043F\\u0435\\u0440 \\u043C\\u044B \\u0431\\u0443\\u0434\\u0437\\u0435\\u043C \\u0432\\u0435\\u0434\\u0430\\u0446\\u044C \\u0441\\u0432\\u0430\\u0456\\u0445, \\u0448\\u0442\\u043E \\u043D\\u0430\\u0440\\u0430\\u0434\\u0437\\u0456\\u043B\\u0456\\u0441\\u044F \\u043D\\u0435 \\u0442\\u043E\\u043B\\u044C\\u043A\\u043E \\u0437\\u0430 \\u043F\\u043E\\u043B\\u044C\\u0441\\u043A\\u0456\\u043C \\u0447\\u0430\\u0441\\u0430\\u043C, \\u0430 \\u043D\\u0430\\u0432\\u0430\\u0442 \\u0437\\u0430 \\u201C\\u043B\\u0456\\u0446\\u044C\\u0432\\u0456\\u043D\\u0441\\u043A\\u0456\\u043C\\u201D \\u0447\\u0430\\u0441\\u0430\\u043C,  \\u0443 \\u0412\\u041A\\u041B.\"})]});};","map":{"version":3,"names":["Typography","React","styles","HomeButton","jsx","_jsx","jsxs","_jsxs","Fragment","_Fragment","IntroRoute","children","style","display","level","className","textBlock"],"sources":["C:/Users/User/Documents/BiejFamilyHistory/src/routes/introduction.tsx"],"sourcesContent":["import Typography from '@mui/joy/Typography';\r\nimport React from 'react';\r\nimport styles from \"./styles.module.css\"\r\nimport {HomeButton} from 'components/HomeButton/HomeButton.tsx'\r\n\r\nexport function IntroRoute() {\r\n  return (\r\n    <>\r\n    \r\n    <div style = {{display: 'flex'}}>\r\n        <HomeButton/>\r\n        <Typography level=\"h2\">З чаго ўсе пачалося</Typography>\r\n    </div>\r\n    \r\n    <Typography className={styles.textBlock}>\r\n        Мяне заўсёды цікавіла гэта тэма, але ўсе рукі не даходзілі. А тут мяне  папрасілі дапамогі з інфармацыяй для школьнага заданьня, а потым і самому захацелася больш даведацца пра імёны прадзедаў. <br/>\r\nАказалася, што нават ў адкрытым доступе можна знайсьці многа звестак.\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\nТак уцягнуўся — дакумэнты, архівы, і вось што атрымалася.\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\nЗ чаго пачаць...\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\nСтарыя дакумэнты ў сям’і — з гэтым усё кепска, усё страчана ці спалена :) Пара фотаздымкаў і адна неапазнаная.\r\n    </Typography>\r\n    \r\n    <Typography className={styles.textBlock}>\r\nРасспыты сярод сваякоў — самая каштоўная, хоць і хутка забываючая крыніца :\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\nРазмова з маці дала пару імёнаў і прозвішчаў, але памяць і дакумэнты часам не супадаюць.\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\nАнлайн-базы даных — сайты накшталт FamilySearch, Geneteka, «Памяць народа», Усеагульнае генэалагічнае дрэва, архівы, тэматычная чаты ў соцсетках — усё гэта дапамагае адшукаць сьляды продкаў, асабліва калі яны служылі.<br/>\r\nРэвізскія сказкі і метрычныя кнігі.\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\nРэві́зскія ска́зкі — дакумэнты, якія адлюстроўваюць вынікі правядзеньня падушных перапісей («рэвізій») падатнага насельніцтва Расейскай імпэрыі ў пачатку XVIII — другой палове XIX стагоддзяў, праводзімых з мэтай падаткаабкладаньня «рэвізскіх душ» (то бок усіх, акрамя дваран і вайскоўцаў).\r\nГэта старыя сьпісы і запісы, дзе ўказвалі сем’і паіменна — з узростам, сваяцтвам і месцам жыхарства. Усё здавалася проста, але са складанасьцямі. Узрост часта не супадае: сяляне маглі не памятаць дакладнага года ці карысна яго сказіць, перапісчыкі маглі акругліць або арыентавацца па знешнім выглядзе, асабліва памыляючыся з пажылымі людзьмі. Сказкі такія часам казкі.\r\nІмёны таксама запісвалі па-рознаму з нагоды і выпадку, асабліва пры пераходзе з польскай лацінкі на рускую кірыліцу.\r\nПрозвішчы на рускай запісаны з указаньнем на прыналежнасьць, чый / чыя / чые — Вайтовічэў, Гаўронаўна, Беевы.\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\nГалоўнае — ня баіцца першых дзіўнасьцяў, далей становіцца толькі цікавей.\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\nПаехалі…\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\n24 кастрычніка 1795 году Расея, Прусія і Аўстрыя ўзаемна ўзгаднілі дагавор аб канчатковым Трэцім падзеле Рэчы Паспалітай абодвух народаў , па якім тэрыторыя Лідзкага павету перайшла да Расейскай імпэрыі. У кастрычніку 1795 года на тэрыторыі павету  правялі інвэнтарызацыю маёнткаў і належных ім фальваркаў з указаньнем дымоў (dymów) і тых, хто ў іх жыве, душ мужчынскага і жаночага полу. Слова «дым» у дадзеным кантэксьце азначала асобную сялянскую гаспадаркау, то бок дом, часцей за ўсё пад кіраўніцтвам аднаго галавы сям’і.\r\nУ перапісах і падатковых сьпісах «дымы» служылі адзінкай уліку для падаткаабкладаньня.\r\nАдзін «дым» мог уключаць некалькі пакаленьняў адной сям’і. Часам некалькі «душ» у адным «дыме» мелі розныя прозвішчы — яны маглі быць сваякамі або жыхарамі аднаго гаспадарства.\r\n    </Typography>\r\n    <Typography className={styles.textBlock}>\r\nЦяпер мы будзем ведаць сваіх, што нарадзіліся не только за польскім часам, а нават за “ліцьвінскім” часам,  у ВКЛ. \r\n    </Typography>\r\n    </>\r\n  );\r\n};\r\n"],"mappings":"AAAA,MAAO,CAAAA,UAAU,KAAM,qBAAqB,CAC5C,MAAO,CAAAC,KAAK,KAAM,OAAO,CACzB,MAAO,CAAAC,MAAM,KAAM,qBAAqB,CACxC,OAAQC,UAAU,KAAO,sCAAsC,QAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,CAAAC,QAAA,IAAAC,SAAA,yBAE/D,MAAO,SAAS,CAAAC,UAAUA,CAAA,CAAG,CAC3B,mBACEH,KAAA,CAAAE,SAAA,EAAAE,QAAA,eAEAJ,KAAA,QAAKK,KAAK,CAAI,CAACC,OAAO,CAAE,MAAM,CAAE,CAAAF,QAAA,eAC5BN,IAAA,CAACF,UAAU,GAAC,CAAC,cACbE,IAAA,CAACL,UAAU,EAACc,KAAK,CAAC,IAAI,CAAAH,QAAA,CAAC,qGAAmB,CAAY,CAAC,EACtD,CAAC,cAENJ,KAAA,CAACP,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,EAAC,+9BAC6J,cAAAN,IAAA,QAAI,CAAC,0WAE3M,EAAY,CAAC,cACbA,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,iSAEzC,CAAY,CAAC,cACbN,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,yEAEzC,CAAY,CAAC,cACbN,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,wiBAEzC,CAAY,CAAC,cAEbN,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,mYAEzC,CAAY,CAAC,cACbN,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,kcAEzC,CAAY,CAAC,cACbJ,KAAA,CAACP,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,EAAC,igCAC4K,cAAAN,IAAA,QAAI,CAAC,4LAE1N,EAAY,CAAC,cACbA,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,u6IAKzC,CAAY,CAAC,cACbN,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,iYAEzC,CAAY,CAAC,cACbN,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,kDAEzC,CAAY,CAAC,cACbN,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,+5HAIzC,CAAY,CAAC,cACbN,IAAA,CAACL,UAAU,EAACe,SAAS,CAAEb,MAAM,CAACc,SAAU,CAAAL,QAAA,CAAC,2jBAEzC,CAAY,CAAC,EACX,CAAC,CAEP,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}